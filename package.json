{
  "name": "github-commits-leaderboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && npm run deploy:worker",
    "deploy:worker": "OPEN_NEXT_DEPLOY=true wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "db:migrate": "node scripts/migrate.mjs",
    "rollout:preflight": "node scripts/refresh-rollout-preflight.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test scripts/theme-launch-badge.test.mjs scripts/refresh-contract.test.mjs scripts/github-refresh.test.mjs scripts/postgres.test.mjs scripts/isolated-postgres.test.mjs scripts/refresh-producer.test.mjs scripts/refresh-consumer.test.mjs scripts/refresh-dlq.test.mjs scripts/refresh-entrypoints.test.mjs scripts/refresh-worker-config.test.mjs scripts/refresh-rollout-preflight.test.mjs",
    "test:integration": "node --import tsx --test --test-concurrency=1 scripts/refresh-migration.integration.test.mjs scripts/refresh-repository.integration.test.mjs scripts/refresh-producer.integration.test.mjs",
    "test:types": "tsc --noEmit --incremental false",
    "test:worker": "tsc -p tsconfig.worker.json --noEmit"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.17.1",
    "@primer/octicons-react": "^19.22.0",
    "@primer/primitives": "^11.5.1",
    "@primer/react": "^38.13.0",
    "next": "16.1.6",
    "pg": "^8.19.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tsx": "4.23.12",
    "typescript": "^5",
    "wrangler": "^4.69.0"
  }
}
