{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "githubcommitsleaderboard",
	"account_id": "776e99cad6263022ce616ccd9c25663e",
	"main": "worker.ts",
	"compatibility_date": "2026-03-02",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"preview_urls": true,
	"upload_source_maps": false,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
		"run_worker_first": false
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"APP_URL": "https://ghcommits.com",
		"NEXT_PUBLIC_REPOSITORY_URL": "https://github.com/BennettSchwartz/GithubCommitsLeaderboard"
	},
	"secrets": {
		"required": [
			"CRON_SECRET",
			"GITHUB_CLIENT_ID",
			"GITHUB_CLIENT_SECRET",
			"SESSION_SECRET",
			"TOKEN_ENCRYPTION_KEY"
		]
	},
	// Hyperdrive for Neon PostgreSQL connection pooling
	// 1. Create config: npx wrangler hyperdrive create neon-leaderboard --connection-string="postgres://USER:PASS@HOST/DB"
	// 2. Copy the returned ID below
	// 3. For local dev with wrangler, set DATABASE_URL in .dev.vars or
	//    CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE in your shell.
	// 4. npm run deploy builds OpenNext and deploys directly with Wrangler.
	//    Remote deployment does not require local Hyperdrive connection strings.
	// 5. npm run dev with .env.local bypasses wrangler and uses Next.js directly.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "aee89c7b5b11441c9ea84decaaab2a08"
		},
		{
			"binding": "REFRESH_HYPERDRIVE",
			"id": "c3216e0fac3d4d839568344228f228e5"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "REFRESH_QUEUE",
				"queue": "githubcommits-refresh"
			}
		],
		"consumers": [
			{
				"queue": "githubcommits-refresh",
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"dead_letter_queue": "githubcommits-refresh-dlq",
				"max_concurrency": 2,
				"retry_delay": 300
			},
			{
				"queue": "githubcommits-refresh-dlq",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 10,
				"max_concurrency": 1,
				"retry_delay": 7200
			}
		]
	},
	// Add a KV namespace for shared rate limiting in production:
	// "kv_namespaces": [
	//   {
	//     "binding": "RATE_LIMITS",
	//     "id": "replace-me",
	//     "preview_id": "replace-me"
	//   }
	// ],
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	}
}
